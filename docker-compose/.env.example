# Copy to .env (gitignored) and fill in real values from 1Password.
# Never commit .env itself.
#
# WAZUH_INDEXER_PASSWORD and WAZUH_DASHBOARD_PASSWORD ALSO require a matching
# bcrypt hash in config/wazuh_indexer/internal_users.yml, pushed live via
# securityadmin.sh. Changing only this file will NOT rotate those two —
# see README.md's "Credential rotation" section for the full procedure.
#
# WAZUH_API_PASSWORD ALSO requires a matching update in the `password:` field
# of config/wazuh_dashboard/wazuh.yml (not compose-templated — edited directly).

# admin user — indexer login, dashboard login
WAZUH_INDEXER_PASSWORD=changeme

# kibanaserver user — dashboard's internal service account to the indexer
WAZUH_DASHBOARD_PASSWORD=changeme

# wazuh-wui user — manager's REST API (port 55000)
WAZUH_API_PASSWORD=changeme
